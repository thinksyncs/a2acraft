{
  "name": "personal-chat-ui",
  "version": "0.4.3",
  "private": true,
  "description": "A2ACraft by Toppy — conversations become worlds.",
  "author": "ToppyMicroServices",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinksyncs/a2acraft.git"
  },
  "homepage": "https://github.com/thinksyncs/a2acraft",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "postinstall": "node scripts/prepare-terminal.mjs",
    "start": "node server.mjs",
    "desktop": "electron .",
    "desktop:demo": "electron . --demo",
    "test": "node scripts/check-module-size.mjs && node --test test/*.test.mjs electron/*.test.mjs",
    "dist": "electron-builder",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:mac:arm64": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "pack:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir --publish never",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "check:modules": "node scripts/check-module-size.mjs",
    "prepare:distribution": "node scripts/build-app-icon.mjs && node scripts/prepare-distribution-notices.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@openai/codex": "0.169.0",
    "@xberg-io/xberg": "1.3.7",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "global-agent@3.0.0": {
      "roarr": "3.2.0"
    }
  },
  "build": {
    "appId": "com.thinksyncs.chatui",
    "productName": "A2ACraft",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/*.mjs",
      "!electron/*.test.mjs",
      "electron/preload.cjs",
      "package.json",
      "!node_modules/@openai/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@xberg-io/**/*"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "backend",
        "filter": [
          "server.mjs",
          "backend-bootstrap.mjs",
          "public-assets.mjs",
          "send-delivery.mjs",
          "policy.mjs",
          "terminal.mjs",
          "context-board.mjs",
          "attachments.mjs",
          "document-extraction.mjs",
          "local-store.mjs",
          "plugins.mjs",
          "backlog.mjs",
          "teams.mjs",
          "teams-drafts.mjs",
          "work-quests.mjs",
          "adventure.mjs",
          "village.mjs",
          "projects.mjs",
          "project-workspaces.mjs",
          "project-codex.mjs",
          "agent-board.mjs",
          "agent-delegation.mjs",
          "agent-board-tools.mjs",
          "world-state.mjs",
          "world-artifacts.mjs",
          "board-dispatch.mjs",
          "todos.mjs",
          "media.mjs",
          "inbox.mjs",
          "schedules.mjs",
          "reports.mjs",
          "codex-history.mjs",
          "imported-history-context.mjs",
          "public/**/*",
          "codex-workspace-policy.mjs",
          "codex-launch.mjs",
          "codex-readiness.mjs",
          "conversation-workspace.mjs"
        ]
      },
      {
        "from": "node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin",
        "to": "codex",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "artifacts/distribution-notices",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": null,
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/mac/A2ACraft.icns"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "maintainer": "ToppyMicroServices",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "scripts/sign-mac-review.cjs",
    "beforePack": "scripts/check-mac-platform.cjs"
  }
}
